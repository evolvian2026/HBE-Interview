# --- Database (Neon Postgres) ---
# Neon connection string, e.g. postgres://user:pass@ep-xxx.region.aws.neon.tech/hbe?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hbe
# On Neon use the DIRECT endpoint (host without "-pooler"): the interview engine uses session-level advisory locks,
# which are not safe through a transaction-mode connection pooler.

# --- App ---
APP_BASE_URL=http://localhost:3000
# 32+ random characters used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# First admin account, created by `npm run db:seed` (and on first boot if no users exist)
ADMIN_EMAIL=admin@hbe.local
ADMIN_PASSWORD=change-me

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=
# Set to "true" to run without an API key using deterministic mock AI (development / CI only)
AI_MOCK=false
# Optional per-stage model overrides
# AI_MODEL_INTERVIEWER=claude-sonnet-5-5
# AI_MODEL_EVALUATOR=claude-opus-5-5
# AI_MODEL_UTILITY=claude-haiku-5-5

# --- Code execution ---
# judge0 (default) | aws-lambda (infra/aws-executor) | local-dev (UNSAFE: runs code on this machine; development only, refused in production)
CODE_EXECUTOR=judge0
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
# For RapidAPI-hosted Judge0 set the host header; leave empty for self-hosted
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# AWS Lambda executor (CODE_EXECUTOR=aws-lambda) — see infra/aws-executor/README.md
# AWS_REGION=ap-south-1
# AWS_LAMBDA_FUNCTION=hbe-executor
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- GitHub (public repos only) ---
# Optional but recommended: raises the API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# --- Background jobs ---
# Run the job worker inside the web process (simplest). Set false if you run `npm run worker` separately.
RUN_WORKER_IN_PROCESS=true

# --- Email (optional; invites are always shown as copyable links) ---
RESEND_API_KEY=
EMAIL_FROM=HBE Interview <interviews@example.com>

# --- Natural voice (optional; without it voice mode uses the browser's built-in speech) ---
# Azure AI Speech resource key and region (e.g. centralindia). Used for the interviewer's voice and for
# transcribing spoken answers. Audio is not stored by HBE Interview.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: fast transcription API version, extra transcription locales (comma separated), voice overrides
# AZURE_SPEECH_API_VERSION=2024-11-15
# AZURE_STT_LOCALES=ta-IN,te-IN
# AZURE_SPEECH_VOICES={"en-IN":["en-IN-NeerjaNeural","en-IN-PrabhatNeural"]}
# Estimates for the usage page (USD) — set to your Azure prices
# SPEECH_PRICE_PER_MILLION_CHARS=16
# SPEECH_PRICE_PER_AUDIO_HOUR=1
# Development / tests only: fake speech service (short tones; a fixed transcript)
SPEECH_MOCK=false

# --- Calendar sync (optional): free/busy for panel scheduling + Google Meet / Teams events ---
# Redirect URIs to register: <APP_BASE_URL>/api/calendar/callback/google and .../callback/microsoft
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Microsoft tenant: "common" (any work account) or your tenant id to restrict to your organisation
# MICROSOFT_CALENDAR_TENANT=common
# Development / tests only: a fake calendar (fixed busy hours, fake meeting links)
CALENDAR_MOCK=false
